{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "outDir": "dist/webview",
    "rootDir": "src/webview",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/webview/**/*.ts"]
}
